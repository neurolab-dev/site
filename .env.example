# Copie este arquivo para `.env` e preencha o que já existir.
# Tudo aqui é opcional: sem valor, o recurso correspondente simplesmente não é
# ativado — nenhum script de terceiro entra na página por acidente.
#
# O prefixo PUBLIC_ é exigido pelo Astro para variáveis que chegam ao navegador.
# Não coloque segredo nenhum aqui: tudo com esse prefixo vai para o HTML final.

# Webhook do n8n que recebe os leads do formulário de diagnóstico.
# Sem ele, o formulário não é renderizado e o bloco de contato cai para WhatsApp.
PUBLIC_N8N_WEBHOOK_URL=

# Google Analytics 4 — ex.: G-XXXXXXXXXX
PUBLIC_GA_ID=

# Google Tag Manager — ex.: GTM-XXXXXXX
PUBLIC_GTM_ID=

# Conteúdo da meta tag de verificação do Google Search Console.
PUBLIC_SEARCH_CONSOLE=

# --- Build (sem prefixo PUBLIC_: são lidas só em astro.config.mjs) ---

# URL canônica do site. Trocar quando o domínio próprio for adquirido.
# SITE_URL=https://neurolab.com.br

# Prefixo de caminho. "/" na Vercel e em domínio próprio.
# O workflow do GitHub Pages define "/neurolab-site/" sozinho.
# SITE_BASE=/
