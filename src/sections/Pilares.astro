---
/**
 * Os quatro pilares de serviço.
 *
 * Cada card abre pela dor e só depois lista a entrega — mesma lógica da seção de
 * problema. O link de conversa de cada pilar leva uma mensagem própria para o
 * WhatsApp, o que dá rastreabilidade de qual frente gerou o contato sem depender
 * de analytics.
 */
import Icone from "../components/Icone.astro";
import { pilares } from "../data/pilares";
import Atmosfera from "../components/Atmosfera.astro";
---

<section id="pilares" class="secao secao-viva pilares-vivos bg-fundo" aria-labelledby="titulo-pilares">
  <Atmosfera />
  <div class="container-conteudo relative pilares-layout">
    <div class="max-w-leitura pilares-intro" data-revelar>
      <p class="mb-4 text-caption font-semibold uppercase tracking-[0.18em] text-marca-texto">
        O que fazemos
      </p>
      <h2 id="titulo-pilares" class="titulo-secao font-semibold">
        Quatro frentes de inteligência aplicada
      </h2>
      <p class="mt-5 text-body text-texto-secundario">
        Elas se combinam conforme o diagnóstico. Nenhuma empresa precisa das quatro ao
        mesmo tempo — precisa da que destrava o gargalo atual.
      </p>
    </div>

    <ul class="grade-pilares grid gap-6">
      {
        pilares.map((pilar, indice) => (
          <li
            id={`pilar-${pilar.id}`}
            class="card-pilar flex flex-col rounded-md border border-borda bg-superficie p-6 md:p-8"
            data-revelar
          >
            <div class="flex items-start justify-between gap-4">
              <span
                class="flex h-12 w-12 items-center justify-center rounded-md bg-red-50 text-red-700"
                aria-hidden="true"
              >
                <Icone nome={pilar.icone} tamanho={24} />
              </span>
              <span class="numero-pilar" aria-hidden="true">0{indice + 1}</span>
            </div>

            <h3 class="mt-5 text-h2 font-semibold">{pilar.nome}</h3>
            <p class="mt-2 text-body font-medium text-marca-texto">{pilar.resumo}</p>
            <p class="mt-4 text-caption leading-relaxed text-texto-secundario">{pilar.dor}</p>

            <ul class="mt-6 flex flex-col gap-2.5 border-t border-borda pt-6">
              {pilar.entregas.map((entrega) => (
                <li class="flex items-start gap-2.5 text-caption">
                  <Icone nome="check" tamanho={16} class="mt-0.5 shrink-0 text-red-700" />
                  <span>{entrega}</span>
                </li>
              ))}
            </ul>

            <span class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-marca-texto">
              <i class="h-1.5 w-1.5 rounded-full bg-red-600"></i> frente ativa
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
