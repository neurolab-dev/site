---
/**
 * Grade de serviços concretos.
 *
 * Os pilares dizem que problema resolvemos; esta lista existe para quem chega
 * procurando pelo nome do serviço ("automação n8n", "tráfego pago") e precisa se
 * reconhecer na página em dois segundos. Também é a seção que carrega os termos
 * de busca pelos quais a empresa quer ser encontrada.
 */
import Icone from "../components/Icone.astro";
import { servicos } from "../data/servicos";
import { pilares } from "../data/pilares";
import Atmosfera from "../components/Atmosfera.astro";

const nomeDoPilar = Object.fromEntries(pilares.map((p) => [p.id, p.nome]));
---

<section id="servicos" class="secao secao-viva servicos-vivos bg-fundo-sutil" aria-labelledby="titulo-servicos">
  <Atmosfera />
  <div class="container-conteudo relative">
    <div class="max-w-leitura">
      <p class="mb-4 text-caption font-semibold uppercase tracking-[0.18em] text-marca-texto">
        Serviços
      </p>
      <h2 id="titulo-servicos" class="titulo-secao font-semibold">
        O que entregamos na prática
      </h2>
      <p class="mt-5 text-body text-texto-secundario">
        Cada serviço existe para resolver um problema específico — e quase nunca vem
        sozinho. O diagnóstico define a combinação e a ordem.
      </p>
    </div>

    <div class="servicos-controles mt-10" aria-label="Navegação dos serviços">
      <p><span class="dica-desktop">Continue rolando a página para explorar todas as frentes.</span><span class="dica-mobile">Deslize para explorar todas as frentes.</span></p>
      <div>
        <button type="button" class="controle-carrossel" data-carrossel-anterior aria-controls="trilha-servicos" aria-label="Ver serviços anteriores">
          <Icone nome="seta-direita" tamanho={18} />
        </button>
        <button type="button" class="controle-carrossel" data-carrossel-proximo aria-controls="trilha-servicos" aria-label="Ver próximos serviços">
          <Icone nome="seta-direita" tamanho={18} />
        </button>
      </div>
    </div>

    <div class="servicos-janela" data-carrossel>
      <ul id="trilha-servicos" class="servicos-trilha mt-4" aria-label="Serviços da NeuroLab">
      {
        servicos.map((servico, indice) => (
          <li class="cartao-cena" data-revelar>
            <h3 class="sr-only">{servico.nome}</h3>
            <button class="cartao-virar" type="button" data-card-virar data-nome={servico.nome} data-descricao={servico.descricao} aria-expanded="false" aria-label={`Ver detalhes: ${servico.nome}`}>
              <span class="cartao-miolo" aria-hidden="true">
                <span class="cartao-face cartao-frente">
                  <span class="cartao-indice">NEUROLAB / {String(indice+1).padStart(2,"0")}</span>
                  <span class="cartao-grafismo"><span></span><span></span><Icone nome={servico.icone} tamanho={44} /></span>
                  <span class="cartao-categoria">{nomeDoPilar[servico.pilar]}</span>
                  <span class="cartao-titulo">{servico.nome}</span>
                  <span class="cartao-gesto">Explorar solução <Icone nome="seta-direita" tamanho={18} /></span>
                </span>
                <span class="cartao-face cartao-verso">
                  <span class="cartao-indice">APLICAÇÃO / {String(indice+1).padStart(2,"0")}</span>
                  <span class="cartao-titulo">{servico.nome}</span>
                  <span class="cartao-descricao">{servico.descricao}</span>
                  <span class="cartao-gesto">Voltar <Icone nome="seta-direita" tamanho={18} /></span>
                </span>
              </span>
            </button>
            <p class="sr-only">{servico.descricao}</p>
          </li>
        ))
      }
      </ul>
    </div>
  </div>
</section>
