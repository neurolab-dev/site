---
/** Diagrama conceitual: da operação dispersa à decisão orientada por dados. */
---

<div class="fluxo-manifesto" aria-hidden="true">
  <div class="fluxo-manifesto__topo">
    <span class="fluxo-manifesto__marca"><i></i> NEUROLAB / SISTEMA EM MOVIMENTO</span>
    <span class="fluxo-manifesto__estado">FLUXO ATIVO</span>
  </div>

  <div class="fluxo-manifesto__mapa">
    <div class="fluxo-manifesto__origens">
      <span>PROCESSOS</span>
      <span>SISTEMAS</span>
      <span>CONTATOS</span>
    </div>
    <div class="fluxo-manifesto__conexoes"><i></i><i></i><i></i></div>
    <div class="fluxo-manifesto__nucleo">
      <span class="fluxo-manifesto__orbita"></span>
      <span class="fluxo-manifesto__pulso"></span>
      <strong>AUTOMAÇÃO</strong>
      <small>INTELIGÊNCIA APLICADA</small>
    </div>
    <div class="fluxo-manifesto__conexoes fluxo-manifesto__conexoes--saida"><i></i><i></i><i></i></div>
    <div class="fluxo-manifesto__destinos">
      <span>DADOS ORGANIZADOS</span>
      <span>DECISÕES CLARAS</span>
      <span>PROCESSOS MELHORES</span>
    </div>
  </div>

  <div class="fluxo-manifesto__rodape">
    <div>
      <span>EVOLUÇÃO CONTÍNUA</span>
      <svg viewBox="0 0 340 80" preserveAspectRatio="none" fill="none" focusable="false">
        <path class="fluxo-manifesto__guia" d="M0 60H340M0 30H340" />
        <path class="fluxo-manifesto__linha" d="M0 66C36 64 48 72 78 59C110 45 130 57 158 43C188 30 210 44 238 25C266 7 291 19 340 5" />
      </svg>
    </div>
    <span class="fluxo-manifesto__nota">VISUALIZAÇÃO CONCEITUAL</span>
  </div>
</div>
