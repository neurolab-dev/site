---
/**
 * Conjunto de ícones do site.
 *
 * Padrão de 04-logo-e-elementos-graficos.md: minimalista, outline, geométrico,
 * traço 2px. Todos desenhados na mesma grade de 24×24 — a regra é explícita:
 * nenhum ícone de outra biblioteca ou estilo pode se misturar ao conjunto.
 *
 * São SVG inline, não uma biblioteca de runtime: zero JavaScript no cliente e a
 * cor acompanha `currentColor` sozinha.
 *
 * A única exceção ao outline é o glifo do WhatsApp — marca registrada, precisa
 * ser reconhecível na forma oficial, preenchida.
 */

interface Props {
  nome: string;
  tamanho?: number;
  class?: string;
  /** Ícones decorativos ficam invisíveis para leitores de tela (o padrão). */
  rotulo?: string;
}

const { nome, tamanho = 24, class: classe = "", rotulo } = Astro.props;

/** Traçados outline — herdam stroke, linecap e linejoin do <svg>. */
const tracos: Record<string, string> = {
  alvo: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
  engrenagens:
    '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><path d="M6.5 10v3.5a4 4 0 0 0 4 4H14"/>',
  tela: '<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
  bussola: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  cerebro:
    '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>',
  busca: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  grafico: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 16v-5M12 16V8M17 16v-3"/>',
  conexao:
    '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="6" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="m7.2 10.8 9.6-3.6M7.2 13.2l9.6 3.6"/>',
  "banco-dados":
    '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/>',
  camadas: '<path d="m12 3 9 4.5-9 4.5-9-4.5z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  megafone:
    '<path d="M4 10v4a1 1 0 0 0 1 1h2l7 4V5L7 9H5a1 1 0 0 0-1 1Z"/><path d="M18 9a4 4 0 0 1 0 6"/>',
  crescimento: '<path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/>',
  relogio: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  alerta: '<path d="M12 4 2.5 20h19z"/><path d="M12 10v4M12 17h.01"/>',
  calendario: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/>',
  email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2.5 6.5 9.5 7 9.5-7"/>',
  telefone:
    '<path d="M6 3h3l2 5-2.5 1.5a11 11 0 0 0 5 5L15 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z"/>',
  local: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  "seta-direita": '<path d="M5 12h14M13 6l6 6-6 6"/>',
  "seta-baixo": '<path d="M12 5v14M6 13l6 6 6-6"/>',
  check: '<path d="m4 12 5 5L20 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  fechar: '<path d="m6 6 12 12M18 6 6 18"/>',
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  linkedin:
    '<rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 10v7M7 7h.01M11.5 17v-4a2.5 2.5 0 0 1 5 0v4"/><path d="M11.5 17v-6"/>',
};

/** Glifos preenchidos — marcas registradas, fora do padrão outline. */
const preenchidos: Record<string, string> = {
  whatsapp:
    '<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.19 8.19 0 0 1 5.82 2.42 8.17 8.17 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.19-.53.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.23-1.46-1.38-1.71-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.66.31-.23.24-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.22-.17-.47-.29Z"/>',
};

const preenchido = nome in preenchidos;
const conteudo = preenchidos[nome] ?? tracos[nome];

if (!conteudo) {
  throw new Error(
    `Icone: "${nome}" não existe. Ícones disponíveis: ${[...Object.keys(tracos), ...Object.keys(preenchidos)].join(", ")}`
  );
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill={preenchido ? "currentColor" : "none"}
  stroke={preenchido ? "none" : "currentColor"}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classe}
  role={rotulo ? "img" : undefined}
  aria-label={rotulo}
  aria-hidden={rotulo ? undefined : "true"}
  set:html={conteudo}
/>
