---
/**
 * Elemento gráfico de rede neural — textura de fundo.
 *
 * 04-logo-e-elementos-graficos.md define este elemento como derivado do símbolo
 * da logo (nós conectados por linhas orgânicas) e fixa a regra de uso: opacidade
 * de 5% a 15% em fundos de banner e landing page, nunca mais que isso. Deve
 * permanecer textura, não virar protagonista.
 *
 * É desenhado por código em vez de ser uma imagem: um SVG de poucos KB, nítido
 * em qualquer densidade de tela, que herda a cor do contexto por `currentColor`.
 * A geração é determinística — a mesma semente produz sempre o mesmo desenho, e
 * não há surpresa visual entre um build e outro.
 *
 * Isto NÃO é a logo. É textura decorativa, e por isso fica fora da árvore de
 * acessibilidade.
 */

interface Props {
  /** Entre 0.05 e 0.15, por regra do design system. */
  opacidade?: number;
  /** Trocar para redesenhar a malha mantendo o mesmo estilo. */
  semente?: number;
  class?: string;
}

const { opacidade = 0.1, semente = 7, class: classe = "" } = Astro.props;

if (opacidade < 0.05 || opacidade > 0.15) {
  throw new Error(
    `RedeNeural: opacidade ${opacidade} fora da faixa de 5%–15% definida em ` +
      `04-logo-e-elementos-graficos.md. A textura não pode virar protagonista.`
  );
}

const L = 800;
const A = 600;

/** PRNG determinístico (mulberry32) — mesma semente, mesmo desenho. */
function aleatorio(estado: number) {
  return () => {
    estado |= 0;
    estado = (estado + 0x6d2b79f5) | 0;
    let t = Math.imul(estado ^ (estado >>> 15), 1 | estado);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rnd = aleatorio(semente);

// Nós distribuídos numa grade com deslocamento aleatório: espalha melhor que
// posições puramente aleatórias, que tendem a se aglomerar e deixar buracos.
const colunas = 8;
const linhas = 6;
const passoX = L / colunas;
const passoY = A / linhas;

const nos = Array.from({ length: colunas * linhas }, (_, i) => {
  const cx = (i % colunas) * passoX + passoX / 2 + (rnd() - 0.5) * passoX * 0.75;
  const cy = Math.floor(i / colunas) * passoY + passoY / 2 + (rnd() - 0.5) * passoY * 0.75;
  return { cx: +cx.toFixed(1), cy: +cy.toFixed(1), r: +(3 + rnd() * 6).toFixed(1) };
});

// Liga cada par de nós próximos. O limite de distância controla a densidade da
// malha: alto demais vira teia fechada, baixo demais vira pontilhado solto.
const limite = passoX * 1.15;
const ligacoes: { d: string }[] = [];

for (let i = 0; i < nos.length; i++) {
  for (let j = i + 1; j < nos.length; j++) {
    const a = nos[i]!;
    const b = nos[j]!;
    const dx = b.cx - a.cx;
    const dy = b.cy - a.cy;
    if (Math.hypot(dx, dy) > limite) continue;

    // Curva quadrática com o ponto de controle deslocado da reta — é o que dá o
    // aspecto orgânico das conexões da logo, em vez de um grafo de retas.
    const desvio = (rnd() - 0.5) * 0.35;
    const mx = (a.cx + b.cx) / 2 - dy * desvio;
    const my = (a.cy + b.cy) / 2 + dx * desvio;
    ligacoes.push({
      d: `M${a.cx} ${a.cy}Q${mx.toFixed(1)} ${my.toFixed(1)} ${b.cx} ${b.cy}`,
    });
  }
}
---

<svg
  viewBox={`0 0 ${L} ${A}`}
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  focusable="false"
  class:list={["pointer-events-none select-none", classe]}
  style={`opacity:${opacidade}`}
>
  <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
    {ligacoes.map((l) => <path d={l.d} />)}
  </g>
  <g fill="currentColor">
    {nos.map((n) => <circle cx={n.cx} cy={n.cy} r={n.r} />)}
  </g>
</svg>
